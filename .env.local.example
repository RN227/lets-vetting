# ============================================================================
# LetsVet - Local Environment Variables Template
# ============================================================================
# Copy this file to .env.local: cp .env.local.example .env.local
# Then fill in your actual values

# ============================================================================
# Firebase Client Configuration (NEXT_PUBLIC_*)
# ============================================================================
# For local development with emulator, you can use dummy values
# The emulator will work with any values here

NEXT_PUBLIC_FIREBASE_API_KEY=AIzaSyDemoKeyForLocalDevelopment123456789
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=demo-project.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=demo-project
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=demo-project.appspot.com
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=123456789012
NEXT_PUBLIC_FIREBASE_APP_ID=1:123456789012:web:abcdef123456

# ============================================================================
# Firebase Emulator Configuration (for local development)
# ============================================================================
# Uncomment these to use Firebase Emulator Suite
# Make sure to start the emulator first: npm run emulators

FIREBASE_AUTH_EMULATOR_HOST=127.0.0.1:9099
FIRESTORE_EMULATOR_HOST=127.0.0.1:8080

# ============================================================================
# Firebase Admin SDK (for server-side operations)
# ============================================================================
# Not needed when using emulator - leave commented out
# Only needed if connecting to real Firebase (not emulator)

# FIREBASE_SERVICE_ACCOUNT_KEY=

# ============================================================================
# Anthropic API Key (for AI chat functionality)
# ============================================================================
# Required for chat to work - get from https://console.anthropic.com/
# Replace with your actual API key

ANTHROPIC_API_KEY=your_anthropic_api_key_here
