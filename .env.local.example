# Firebase Client Configuration (Public)
# Get these from Firebase Console > Project Settings > General
NEXT_PUBLIC_FIREBASE_API_KEY=your_firebase_api_key_here
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=your_project_id.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=your_project_id_here
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=your_project_id.appspot.com
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=your_sender_id_here
NEXT_PUBLIC_FIREBASE_APP_ID=your_app_id_here

# Firebase Admin Configuration (Server-side only - KEEP PRIVATE!)
# For production: Add your service account key JSON as a single-line string
# Get from Firebase Console > Project Settings > Service Accounts > Generate New Private Key
# FIREBASE_SERVICE_ACCOUNT_KEY={"type":"service_account","project_id":"...","private_key":"..."}

# Firebase Emulator Configuration (Development)
# Uncomment these to use Firebase Emulator Suite (no credentials needed!)
# FIREBASE_AUTH_EMULATOR_HOST=127.0.0.1:9099
# FIRESTORE_EMULATOR_HOST=127.0.0.1:8080

# Anthropic API Configuration
ANTHROPIC_API_KEY=your_anthropic_api_key_here
